{
  "name": "express-postgres-boilerplate",
  "version": "2.0.0",
  "description": "Production-ready Express 5, PostgreSQL, and Drizzle boilerplate",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "M Zubair",
    "url": "https://github.com/mzubair481"
  },
  "keywords": [
    "api",
    "argon2",
    "authentication",
    "biome",
    "boilerplate",
    "docker",
    "drizzle-orm",
    "express",
    "grafana",
    "nodejs",
    "openapi",
    "postgresql",
    "prometheus",
    "typescript",
    "vitest"
  ],
  "homepage": "https://github.com/mzubair481/express-boilerplate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzubair481/express-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/mzubair481/express-boilerplate/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch --clear-screen=false src/bootstrap/server.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "node scripts/install-hooks.mjs",
    "seed": "tsx scripts/seed.ts",
    "start": "node --enable-source-maps dist/bootstrap/server.js",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "biome check . && tsc --noEmit && vitest run --exclude '**/*.integration.test.ts' && tsc -p tsconfig.build.json && drizzle-kit check"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.0",
    "@scalar/express-api-reference": "0.10.17",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.10",
    "nodemailer": "9.1.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prom-client": "15.1.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "lefthook": "2.1.10",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
